{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "pokedex_app",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "debug",
            "toolArgs": [
                "--dart-define-from-file=dart_defines.json"
            ]
        },
        {
            "name": "pokedex_app (profile)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define-from-file=dart_defines.json"
            ]
        },
        {
            "name": "pokedex_app (release)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define-from-file=dart_defines.json"
            ]
        },
        {
            // JavaScript web target (faster compile; no Wasm).
            // Debug: breakpoints, Inspector, DevTools, hot reload.
            "name": "pokedex_app (Chrome JS :5000)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "flutterMode": "debug",
            "toolArgs": [
                "--dart-define-from-file=dart_defines.json",
                "--web-port=5000"
            ]
        },
        {
            // Wasm + COOP/COEP (multi-thread skwasm). Chrome 119+ / Edge.
            // Debug keeps DDS, Inspector, breakpoints and web hot reload.
            // Flutter run enables cross-origin isolation by default with --wasm.
            "name": "pokedex_app (Chrome Wasm debug :5000)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            "flutterMode": "debug",
            "toolArgs": [
                "--dart-define-from-file=dart_defines.json",
                "--wasm",
                "--web-port=5000"
            ]
        },
    ]
}
